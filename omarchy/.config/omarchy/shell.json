{
  "bar": {
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "tmn73.calendar",
          "announceLeadMinutes": 15,
          "format": "ddd d MMM HH:mm",
          "formatAlt": "dddd HH:mm 'W'ww",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "io.github.sspaeti.timezones",
          "icon": "󱉊",
          "hoverExpand": false,
          "homeZones": [
            "Europe/Zurich",
            "Europe/Berlin"
          ],
          "zones": [
            {
              "label": "Switzerland",
              "shortLabel": "CH",
              "zone": "",
              "home": true
            },
            {
              "label": "East Coast",
              "shortLabel": "NY",
              "zone": "America/New_York"
            },
            {
              "label": "West Coast",
              "shortLabel": "SF",
              "zone": "America/Los_Angeles"
            },
            {
              "label": "Cagayan de Oro",
              "shortLabel": "CDO",
              "zone": "Asia/Manila",
              "abbr": "PHT"
            }
          ]
        },
        {
          "id": "eduardodallecort.weather-radar",
          "alertRadiusKm": 50,
          "alertsEnabled": true,
          "alertMinIntensity": "Severe"
        },
        {
          "id": "sspaeti.weather"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "sspaeti.workspaces"
        },
        {
          "id": "pnkm0nk.omodoro"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.kristoferlund.webcam",
          "device": "/dev/video4"
        },
        {
          "id": "agx.screen-time",
          "iconOnly": true
        },
        {
          "id": "quickshell.spotify",
          "deviceName": "Omarchy Spotify",
          "idleShutdownMinutes": 15,
          "showMiniPlayer": "Off",
          "shortcutPlayer": "Omarchy Music app",
          "showTrackTitle": "Off",
          "showArtistName": "Off",
          "scrollBarText": "Off",
          "scrollSpeed": "1",
          "audioQuality": "320 kbps",
          "searchHistory": "[]",
          "sessionState": "{\"tab\":\"playlists\",\"searchText\":\"\",\"searchType\":\"track\",\"libraryType\":\"tracks\",\"homeType\":\"recent\",\"libraryFilter\":\"\",\"librarySort\":\"default\",\"playlistFilter\":\"\",\"playlistSort\":\"default\",\"detailFilter\":\"\",\"detailSort\":\"default\",\"homeFilter\":\"\",\"discoverFilter\":\"\",\"queueFilter\":\"\",\"artistSearchText\":\"\",\"scrollPositions\":{\"home:recent\":0,\"search:track\":0,\"playlist:280QjJVAG0mg9nTzG1Figi\":0,\"playlist:2JNtvF6C5OxltfYiVjDAeX\":102,\"detail:spotify:album:7jzURx17ZW6Yo5153MrLdh\":0},\"detailItem\":null,\"selectedPlaylistId\":\"2JNtvF6C5OxltfYiVjDAeX\",\"lastRadioPlaylist\":null}"
        },
        {
          "id": "io.github.teevans.apple-tv-remote"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "sspaeti.goatcounter",
          "hoverExpand": false,
          "siteLabels": {
            "dedp": "DEDP"
          },
          "alertHourlyViews": {
            "ssp.sh": 50,
            "dedp": 20
          },
          "alertDailyViews": {
            "ssp.sh": 1000,
            "dedp": 150
          },
          "refreshMinutes": 15
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "cpu-temp",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu-temp.sh",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "onRightClick": "omarchy-launch-or-focus tuxedo tuxedo-control-center"
        },
        {
          "id": "sspaeti.tuxedo-profile"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 500
  },
  "plugins": [
    {
      "id": "sspaeti.emojis"
    },
    {
      "id": "sspaeti.clipboard",
      "historyLimit": 2000,
      "maxRows": 100,
      "autoPaste": false,
      "ocr": true,
      "ocrLang": "eng+deu"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.emojis",
    "omarchy.clipboard"
  ],
  "cloneSourceRestores": [
    "sspaeti.emojis",
    "sspaeti.clipboard"
  ]
}
