{
  "bar": {
    "centerAnchor": "sspaeti.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "sspaeti.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "dddd HH:mm 'W'ww",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "sspaeti.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "sspaeti.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.teevans.apple-tv-remote"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "cpu-temp",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu-temp.sh",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "onRightClick": "omarchy-launch-or-focus tuxedo tuxedo-control-center"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 500
  },
  "plugins": [
    {
      "id": "sspaeti.emojis"
    },
    {
      "id": "sspaeti.clipboard",
      "historyLimit": 800,
      "maxRows": 100,
      "autoPaste": false,
      "ocr": true,
      "ocrLang": "eng+deu"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.emojis",
    "omarchy.clipboard"
  ],
  "cloneSourceRestores": [
    "sspaeti.emojis",
    "sspaeti.clipboard"
  ]
}
