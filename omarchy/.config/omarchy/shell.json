{
  "bar": {
    "centerAnchor": "sspaeti.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "sspaeti.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "dddd HH:mm 'W'ww",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "sspaeti.timezones",
          "homeZones": [
            "Europe/Zurich",
            "Europe/Berlin"
          ],
          "zones": [
            {
              "label": "Switzerland",
              "shortLabel": "CH",
              "zone": "",
              "home": true
            },
            {
              "label": "East Coast",
              "shortLabel": "NY",
              "zone": "America/New_York"
            },
            {
              "label": "West Coast",
              "shortLabel": "SF",
              "zone": "America/Los_Angeles"
            },
            {
              "label": "Cagayan de Oro",
              "shortLabel": "CDO",
              "zone": "Asia/Manila",
              "abbr": "PHT"
            }
          ]
        },
        {
          "id": "sspaeti.weather"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "sspaeti.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "agx.screen-time",
          "iconOnly": true
        },
        {
          "id": "quickshell.spotify",
          "deviceName": "Omarchy Spotify",
          "idleShutdownMinutes": 15,
          "showMiniPlayer": "Off",
          "shortcutPlayer": "Omarchy Music app",
          "showTrackTitle": "Off",
          "showArtistName": "Off",
          "scrollBarText": "Off",
          "scrollSpeed": "1",
          "audioQuality": "320 kbps",
          "searchHistory": "[]",
          "sessionState": "{\"tab\":\"setup\",\"searchText\":\"\",\"searchType\":\"track\",\"libraryType\":\"tracks\",\"homeType\":\"recent\",\"libraryFilter\":\"\",\"librarySort\":\"default\",\"playlistFilter\":\"\",\"playlistSort\":\"default\",\"detailFilter\":\"\",\"detailSort\":\"default\",\"homeFilter\":\"\",\"discoverFilter\":\"\",\"queueFilter\":\"\",\"artistSearchText\":\"\",\"scrollPositions\":{\"home:recent\":0,\"search:track\":0,\"playlist:280QjJVAG0mg9nTzG1Figi\":0},\"detailItem\":null,\"selectedPlaylistId\":\"280QjJVAG0mg9nTzG1Figi\",\"lastRadioPlaylist\":null}"
        },
        {
          "id": "io.github.teevans.apple-tv-remote"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "cpu-temp",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu-temp.sh",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "onRightClick": "omarchy-launch-or-focus tuxedo tuxedo-control-center"
        },
        {
          "id": "sspaeti.tuxedo-profile"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 600,
    "screensaver": 500
  },
  "plugins": [
    {
      "id": "sspaeti.emojis"
    },
    {
      "id": "sspaeti.clipboard",
      "historyLimit": 2000,
      "maxRows": 100,
      "autoPaste": false,
      "ocr": true,
      "ocrLang": "eng+deu"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.emojis",
    "omarchy.clipboard"
  ],
  "cloneSourceRestores": [
    "sspaeti.emojis",
    "sspaeti.clipboard"
  ]
}
