# FreshRSS sync
urls-source "freshrss"
freshrss-url "https://rss.sspaeti.duckdns.org/api/greader.php"
freshrss-login "sspaeti"
freshrss-passwordeval "printenv FRESHRSS_PASSWORD"
freshrss-min-items 50
freshrss-flag-star "s"

# general settings
auto-reload yes
max-items 50
reload-threads 20
article-sort-order date-desc
# Wider Title: The %-17T means the feed title is left-aligned with 17 characters. You can increase this number.
articlelist-format "%4i %f %D %?T?|%-33T| ?%t"

# add comments and books mark and store directly in my second brain
bookmark-cmd "sh -c 'echo \"| [$2]($1) | $3 | $4 |\" >> \"/home/sspaeti/Simon/SecondBrain/💡 Resources/RSS Bookmarks/My RSS Bookmarks.md\"' --"

# Shortcuts
# l -> open in default newsboat reader
# o -> open inline with w3m
# O -> open default Browser (Brave)
# external browser
browser "/bin/w3m %u"
# Open in external browser with single O keypress
unbind-key O
bind O article set browser "xdg-open %u"; open-in-browser ; set browser "/bin/w3m %u" -- "Open in default browser"

# try to ignore shorts in YT, only if tag is added:
ignore-article "*" "title =~ \"#shorts\""
ignore-article "*" "content =~ \"#shorts\""

# unbind keys
unbind-key ENTER
unbind-key j
unbind-key k
unbind-key J
unbind-key K
unbind-key g
unbind-key G

# bind keys - vim style
bind-key j down
bind-key k up
bind-key l open
bind-key h quit
#vim like forth an back
bind-key ^I open
bind-key ^O quit

# Move g/G functionality to s/S
bind-key s sort
bind-key S rev-sort

# Group-only feedlist: with urls-source freshrss, local feed lines (! hides,
# tags) are IGNORED - only query lines are read. So we tag all query groups
# with "group" and auto-select that tag to hide the single feeds.
# Ctrl+T shows everything again (incl. Starred items); ,t re-applies groups.
run-on-startup set-tag "group"
macro t set-tag "group" -- "Show only feed groups"

# yazi-style sort shortcuts (`,` is newsboat's macro prefix)
macro m set article-sort-order date-asc -- "Sort by date desc"
macro M set article-sort-order date-desc -- "Sort by date asc"

# Vim-style gg and G for top/bottom
bind gg everywhere home -- "Go to top of list"
bind G everywhere end -- "Go to bottom of list"

# Page navigation
bind-key ^D pagedown
bind-key ^U pageup
bind-key d pagedown
bind-key u pageup


# Remap read/unread from n/N to m/M
unbind-key n
unbind-key N
# Use n/p for navigating through list (especially useful in search results)
bind-key n next #same as j
bind-key p prev #same as k
# use m for read/unread
bind-key M toggle-article-read
bind-key m toggle-article-read


# solarized
color background         default   default
color listnormal         default   default
color listfocus          black     cyan
# color listnormal_unread  default   default
color listnormal_unread  black     yellow
color listfocus_unread   black     cyan
color info               default   black
color article            default   default

# highlights - article metadata
highlight article "(^Feed:.*|^Title:.*|^Author:.*)" cyan default bold
highlight article "(^Link:.*|^Date:.*)" yellow default
highlight article "https?://[^ ]+" green default underline
highlight article "\\[[0-9][0-9]*\\]" magenta default bold
highlight article "\\[image\\ [0-9]+\\]" green default bold
highlight article "\\[embedded flash: [0-9][0-9]*\\]" green default bold
highlight article ":.*\\(link\\)$" cyan default
highlight article ":.*\\(image\\)$" blue default
