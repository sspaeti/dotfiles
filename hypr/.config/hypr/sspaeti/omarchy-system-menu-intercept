#!/bin/bash

# Intercept script for omarchy-menu to add tmux-aware shutdown/restart
# This script wraps systemctl calls to use our custom system menu
# Updated to use omarchy-state like the official omarchy-menu

export PATH="$HOME/.local/share/omarchy/bin:$PATH"

SHUTDOWN_LOG="$HOME/.local/state/omarchy-shutdown.log"

save_and_kill_tmux() {
    if command -v tmux &> /dev/null && tmux list-sessions &> /dev/null; then
        logger -t "omarchy-shutdown" "Found tmux sessions, saving and killing"
        mkdir -p "$(dirname "$SHUTDOWN_LOG")"
        echo "$(date): Found tmux sessions, saving and killing" >> "$SHUTDOWN_LOG"
        # TMUX_PLUGIN_MANAGER_PATH only exists inside tmux's global environment
        # (tpm sets it there), never in the Hyprland session env this script runs
        # in. Ask the server for it; without this the path was "/tmux-resurrect/..."
        # and run-shell failed silently with 127 (no save written since Sep 2026).
        tmux_plugins="$(tmux show-environment -g TMUX_PLUGIN_MANAGER_PATH 2>/dev/null | cut -d= -f2-)"
        tmux_plugins="${tmux_plugins:-$HOME/.config/tmux/plugins/}"
        if tmux run-shell "${tmux_plugins%/}/tmux-resurrect/scripts/save.sh"; then
            logger -t "omarchy-shutdown" "tmux-resurrect save OK"
            echo "$(date): tmux-resurrect save OK" >> "$SHUTDOWN_LOG"
        else
            logger -t "omarchy-shutdown" "tmux-resurrect save FAILED (rc=$?)"
            echo "$(date): tmux-resurrect save FAILED" >> "$SHUTDOWN_LOG"
        fi
        sleep 2
        timeout 2s tmux kill-server || logger -t "omarchy-shutdown" "tmux kill-server timed out, forcing kill"
        logger -t "omarchy-shutdown" "tmux kill-server completed"
        echo "$(date): tmux kill-server completed" >> "$SHUTDOWN_LOG"
    fi
}

if [[ "$1" == "poweroff" ]]; then
    logger -t "omarchy-shutdown" "Shutdown script called - poweroff"
    echo "$(date): Shutdown script called - poweroff" >> /var/log/omarchy-shutdown.log
    save_and_kill_tmux
    omarchy-state clear re*-required
    # Schedule shutdown, then close all windows gracefully (matching upstream pattern)
    nohup bash -c "sleep 2 && systemctl poweroff --no-wall" >/dev/null 2>&1 &
    omarchy-hyprland-window-close-all
    sleep 1
elif [[ "$1" == "reboot" ]]; then
    logger -t "omarchy-shutdown" "Shutdown script called - reboot"
    echo "$(date): Shutdown script called - reboot" >> /var/log/omarchy-shutdown.log
    save_and_kill_tmux
    omarchy-state clear re*-required
    # Schedule reboot, then close all windows gracefully (matching upstream pattern)
    nohup bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 &
    omarchy-hyprland-window-close-all
    sleep 1
elif [[ "$1" == "logout" ]]; then
    logger -t "omarchy-shutdown" "Shutdown script called - logout"
    echo "$(date): Shutdown script called - logout" >> /var/log/omarchy-shutdown.log
    save_and_kill_tmux
    # Schedule session stop, then close all windows gracefully (matching upstream pattern)
    nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &
    omarchy-hyprland-window-close-all
    sleep 1
else
    exec /usr/bin/systemctl "$@"
fi
